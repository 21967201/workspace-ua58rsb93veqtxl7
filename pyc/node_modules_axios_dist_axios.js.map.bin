// utils/index.ts
function parseCOSDomain(domain) {
  const match = domain.match(/^(.+)\.cos\.([^.]+)\.myqcloud\.com$/);
  if (!match) {
    return {
      bucket: "",
      region: ""
    };
  }
  return {
    bucket: match[1],
    region: match[2]
  };
}

